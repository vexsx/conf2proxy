# -----------------------------
# Build-time settings
# -----------------------------
APP_VERSION=v4.1
V2RAY_VERSION=5.49.0

# Docker build architecture.
# amd64 = most x86_64 servers
# arm64 = ARM64 servers
# arm + TARGETVARIANT=v7 = ARMv7
TARGETARCH=amd64
TARGETVARIANT=

# -----------------------------
# Runtime settings
# -----------------------------
TZ=Asia/Tehran
LOGLEVEL=warning

# Local proxy exposed by this container: socks5, http, or both
LOCAL_PROXY_PROTOCOL=socks5

# Container listen address. Keep 0.0.0.0 because Docker port binding controls host exposure.
INBOUND_LISTEN=0.0.0.0

# Used when LOCAL_PROXY_PROTOCOL=socks5 or http
PROXY_PORT=1080

# Used when LOCAL_PROXY_PROTOCOL=both
SOCKS_PORT=1080
HTTP_PORT=1081

# Host-side port binding. Default localhost only.
HOST_PROXY_BIND=127.0.0.1
HOST_PROXY_PORT=1080
HOST_HTTP_PORT=1081

ENABLE_SOCKS_UDP=true
ENABLE_SNIFFING=true
ROUTE_PRIVATE_DIRECT=true
ENABLE_MUX=false
MUX_CONCURRENCY=8

# Optional auth. Use PROXY_AUTH=password, then set PROXY_USER and PROXY_PASS.
PROXY_AUTH=noauth
PROXY_USER=
PROXY_PASS=

# Optional direct link input. Usually leave empty and use ./v2ray/link.txt instead.
V2RAY_LINK=
