# -----------------------------
# Build-time settings
# -----------------------------
APP_VERSION=v5.0
XRAY_VERSION=26.9.9

# Docker build architecture.
# amd64 = most x86_64 servers
# arm64 = ARM64 servers
# arm + TARGETVARIANT=v7 = ARMv7
TARGETARCH=amd64
TARGETVARIANT=

# -----------------------------
# Runtime settings
# -----------------------------
TZ=Asia/Tehran
# debug, info, warning, error or none. Keep warning for heavy traffic.
LOGLEVEL=warning
# true = log every connection (costly under heavy load)
ACCESS_LOG=false

# Local proxy exposed by this container: socks5, http, or both
LOCAL_PROXY_PROTOCOL=socks5

# Container listen address. Keep 0.0.0.0 because Docker port binding controls host exposure.
INBOUND_LISTEN=0.0.0.0

# Used when LOCAL_PROXY_PROTOCOL=socks5 or http
PROXY_PORT=1080

# Used when LOCAL_PROXY_PROTOCOL=both
SOCKS_PORT=1080
HTTP_PORT=1081

# Host-side port binding. Default localhost only.
HOST_PROXY_BIND=127.0.0.1
HOST_PROXY_PORT=1080
HOST_HTTP_PORT=1081

# Host networking: fastest path and required for SOCKS5 UDP from other machines.
# COMPOSE_FILE=compose.yaml:compose.host.yaml

ENABLE_SOCKS_UDP=true
ENABLE_SNIFFING=true
ROUTE_PRIVATE_DIRECT=true
# Mux puts many connections on one TCP stream: keep it off for high throughput.
ENABLE_MUX=false
MUX_CONCURRENCY=8

# -----------------------------
# High-throughput / stall protection
# -----------------------------
# Close an upstream connection whose data is unacknowledged this long (ms).
# Stops connections from hanging for minutes on dropped/blackholed paths. 0 = off.
TCP_USER_TIMEOUT_MS=30000
# Close connections with no traffic in either direction after this many seconds.
CONN_IDLE=300
# Ping gRPC transports so a dead connection is replaced instead of freezing all streams.
GRPC_HEALTH_CHECK=true
# Per-connection buffer in KB. Empty = Xray default (512 on amd64). Lower it on small VPSes.
BUFFER_SIZE_KB=
# Per-socket TCP congestion control, e.g. bbr. It must be in the host's
# net.ipv4.tcp_allowed_congestion_control, otherwise every upstream dial fails.
TCP_CONGESTION=
# uTLS fingerprint used when a TLS/REALITY link has no fp= parameter.
TLS_FINGERPRINT=chrome
# Soft memory limit for Xray's Go runtime, e.g. 256MiB. Empty = no limit.
GOMEMLIMIT=
# Open-file limit for the container.
NOFILE_LIMIT=1048576
# Docker log rotation.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
# Optional end-to-end healthcheck through the tunnel, e.g. http://cp.cloudflare.com/generate_204
HEALTHCHECK_URL=

# Optional auth. Use PROXY_AUTH=password, then set PROXY_USER and PROXY_PASS.
PROXY_AUTH=noauth
PROXY_USER=
PROXY_PASS=

# Optional direct link input. Usually leave empty and use ./v2ray/link.txt instead.
V2RAY_LINK=
